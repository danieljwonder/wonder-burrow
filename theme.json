{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "740px",
			"wideSize": "920px"
		},
		"color": {
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#FF6B0A"
				},
				{
					"name": "Primary Accent",
					"slug": "primary-accent",
					"color": "#FBEADC"
				},
				{
					"name": "Primary Alt",
					"slug": "primary-alt",
					"color": "#FFB27A"
				},
				{
					"name": "Primary Alt Accent",
					"slug": "primary-alt-accent",
					"color": "#4A2410"
				},
				{
					"name": "Main",
					"slug": "main",
					"color": "#171411"
				},
				{
					"name": "Main Accent",
					"slug": "main-accent",
					"color": "#DAD4C9"
				},
				{
					"name": "Base",
					"slug": "base",
					"color": "#F7F4EC"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "#6C6258"
				},
				{
					"name": "Tertiary",
					"slug": "tertiary",
					"color": "#FFFAF0"
				},
				{
					"name": "Border Light",
					"slug": "border-light",
					"color": "#E2DCD1"
				},
				{
					"name": "Border Dark",
					"slug": "border-dark",
					"color": "#4A443D"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Primary",
					"slug": "primary",
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				},
				{
					"name": "Expanded",
					"slug": "expanded",
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				},
				{
					"name": "Condensed",
					"slug": "condensed",
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				},
				{
					"name": "Narrow",
					"slug": "narrow",
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				},
				{
					"name": "Monospace",
					"slug": "monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"lineHeight": "1.55"
		},
		"elements": {
			"heading": {
				"typography": {
					"letterSpacing": "-0.025em"
				}
			},
			"h1": {
				"typography": {
					"letterSpacing": "-0.06em",
					"lineHeight": "1.05"
				}
			},
			"h2": {
				"typography": {
					"letterSpacing": "-0.045em"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|main"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|primary"
					}
				}
			},
			"button": {
				"border": {
					"radius": "999px"
				}
			}
		}
	}
}
