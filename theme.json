{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "740px",
			"wideSize": "920px"
		},
		"color": {
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#CE4770"
				},
				{
					"name": "Primary Accent",
					"slug": "primary-accent",
					"color": "#DED5D0"
				},
				{
					"name": "Primary Alt",
					"slug": "primary-alt",
					"color": "#D4572B"
				},
				{
					"name": "Primary Alt Accent",
					"slug": "primary-alt-accent",
					"color": "#B16803"
				},
				{
					"name": "Main",
					"slug": "main",
					"color": "#2C232E"
				},
				{
					"name": "Main Accent",
					"slug": "main-accent",
					"color": "#A59C9C"
				},
				{
					"name": "Base",
					"slug": "base",
					"color": "#F8EFE7"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "#72696D"
				},
				{
					"name": "Tertiary",
					"slug": "tertiary",
					"color": "#FDF7F3"
				},
				{
					"name": "Border Light",
					"slug": "border-light",
					"color": "#DED5D0"
				},
				{
					"name": "Border Dark",
					"slug": "border-dark",
					"color": "#A59C9C"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Primary",
					"slug": "primary",
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				},
				{
					"name": "Expanded",
					"slug": "expanded",
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				},
				{
					"name": "Condensed",
					"slug": "condensed",
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				},
				{
					"name": "Narrow",
					"slug": "narrow",
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				},
				{
					"name": "Monospace",
					"slug": "monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"lineHeight": "1.55"
		},
		"elements": {
			"heading": {
				"typography": {
					"letterSpacing": "-0.025em"
				}
			},
			"h1": {
				"typography": {
					"letterSpacing": "-0.06em",
					"lineHeight": "1.05"
				}
			},
			"h2": {
				"typography": {
					"letterSpacing": "-0.045em"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|main"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|primary"
					}
				}
			},
			"button": {
				"border": {
					"radius": "999px"
				}
			}
		}
	}
}
